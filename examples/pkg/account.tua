-- 被 demo.tua import 的模块。
-- 只有带 pub 的声明能被别的文件 import；不带 pub 的是本文件私有。

pub class Account {
    id:number,
    name:string = "anonymous",
    tags:array<string> = {},
    greet(self, greeting:string) -> string
        return greeting .. " " .. self.name
    end,
}

local a:number|nil

pub class Admin : Account {
    level:number = 0,
}

class MM {
    id : number = 1,
    f:function(self: MM, x:number) -> number
}

typedef aaa = {
    b:number,
    f:function(self:aaa,c:number)->number=function(self,c)
        return 1
    end
}

-- f 是函数**变量**字段而不是方法：不能写 `function MM.f(…)` 去定义，
-- 也不能写 `MM.f = …`（MM 是类名、不是变量）。它又没默认值，
-- 所以每处构造都得给
local m:MM = MM {
    f = function (self:MM, x:number) -> number
        return self.id + x
    end
}

print(m.id)

local temp =Admin {
    id = 1
}

typedef id = number|nil

local b:id = 2

pub typedef Id = number
pub typedef fHandler = function(evt:string) -> ()

typedef Internal = boolean                  -- 无 pub：别的文件 import 不到

-- 跨文件：`pub class` 既导出类型，也导出**值** —— 别的文件 import 之后可以直接
-- `Account{…}` 构造，emitter 会在那边换成运行时的 get，按需 require 这个模块。
-- 工厂函数不再是非用不可，但它仍然是「构造细节不想暴露」时的选择。
--
-- 表的形状一次定死：模块表要一次写全成完整字面量（下面这样），或声明成
-- 能后加键的 table<K,V>。`local M = {}` 之后再 `M.VERSION:string = …`
-- 那种「先空表再挂字段」的写法不成立 —— 见 README「表的形状一次定死」。
local M = {
    VERSION = "1.0",
    make = function(id:number) -> Account
        return Account{id = id}
    end,
    make_admin = function(id:number) -> Admin
        return Admin{id = id}
    end,
}

return M
